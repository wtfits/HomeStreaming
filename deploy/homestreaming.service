# /etc/systemd/system/homestreaming.service
# Install: sudo useradd --system --home /var/lib/homestreaming homestreaming
#          sudo install -m 755 homestreaming /usr/local/bin/
#          sudo systemctl enable --now homestreaming
[Unit]
Description=HomeStreaming media server
After=network-online.target
Wants=network-online.target

[Service]
User=homestreaming
Group=homestreaming
SupplementaryGroups=video render
ExecStart=/usr/local/bin/homestreaming serve --data-dir /var/lib/homestreaming
StateDirectory=homestreaming
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/homestreaming
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
